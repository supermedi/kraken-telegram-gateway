APP_ENV=development
DATABASE_URL=sqlite:///./gateway.db
DRY_RUN=true
LIVE_TRADING_ENABLED=false
MAX_AMOUNT_USDC=100
MAX_LEVERAGE=2
# Optional stricter safety gate: refuse /confirm when stop loss is missing.
REQUIRE_STOP_LOSS_FOR_CONFIRMATION=false
# Use "*" to allow every Kraken Futures pair explicitly.
ALLOWED_PAIRS=PF_XBTUSD,PF_ETHUSD
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_FUTURES_BASE_URL=https://futures.kraken.com
# Optional local JSON file for manually verified Kraken Futures contract metadata.
KRAKEN_INSTRUMENT_METADATA_PATH=
